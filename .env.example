# Server-side configuration. Set variables in the shell or in Vercel settings.
# If using a local .env file, start Uvicorn with --env-file .env.
# Local SQLite search works with all entries below left commented.

# Vercel defaults to PostgreSQL. Set the database URL in Vercel itself.
# SECUREAGENT_DATABASE_URL=
# SECUREAGENT_DOCUMENT_BACKEND=postgres

# Local retrieval defaults to lexical. Run app.semantic_retrieval prepare
# before opting into hybrid retrieval locally.
# SECUREAGENT_RETRIEVAL=hybrid

# Enable evidence selection only for the listed example projects.
# SECUREAGENT_ALLOW_REMOTE_QA=1
# SECUREAGENT_QA_PROJECTS=XR03,BH04,SG05
# DEEPSEEK_API_KEY=
